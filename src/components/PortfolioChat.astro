---
import { homeHero } from "../data/home";
import { contactLinks, hasConfirmedHref, resumePdf } from "../data/launchAssets";
import { preparedFaqs } from "../data/prepared-faqs.js";

const apiUrl = import.meta.env.PUBLIC_STEVEN_ASSISTANT_URL ??
  (import.meta.env.DEV
    ? "http://127.0.0.1:8787/api/chat"
    : "https://steven-assistant.steven-168.workers.dev/api/chat");

const starterQuestions = [
  "What is Steven's current professional role?",
  "Which technologies has Steven worked with?",
  "What is Steven's leadership philosophy?"
];

function getCtaAnalytics(href: string) {
  if (href === resumePdf.path) {
    return { event: "resume_download", target: "resume_pdf" };
  }
  if (href === "/experience/") {
    return { event: "impact_click", target: "selected_impact" };
  }
  return undefined;
}

const fallbackContactLinks = Object.values(contactLinks)
  .filter(hasConfirmedHref)
  .filter((link) => link.href !== resumePdf.path);
---

<section class="portfolio-chat" aria-labelledby="portfolio-chat-title" data-portfolio-chat data-api-url={apiUrl}>
  <div class="portfolio-chat__intro">
    <p class="portfolio-chat__eyebrow">AI about Steven</p>
    <h1 id="portfolio-chat-title">Ask about Steven</h1>
    <p class="portfolio-chat__description">
      A friendly AI guide to Steven's work and experience. If it doesn't have enough information to answer, it will say so.
    </p>
    <div class="portfolio-chat__actions" aria-label="More ways to explore Steven's portfolio">
      {
        homeHero.ctas.map((cta) => {
          const analytics = getCtaAnalytics(cta.href);
          return (
            <a
              class:list={["button-link", cta.variant === "primary" && "button-link--primary"]}
              href={cta.href}
              download={cta.href === resumePdf.path ? true : undefined}
              data-analytics-event={analytics?.event}
              data-analytics-location="hero"
              data-analytics-target={analytics?.target}
            >
              {cta.label}
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="portfolio-chat__panel">
    <div class="portfolio-chat__transcript" data-transcript role="log" aria-live="polite" aria-relevant="additions text" aria-label="Chat conversation">
      <p class="portfolio-chat__message portfolio-chat__message--assistant">
        Hi. Ask about Steven's role or experience, or choose a question below.
      </p>
    </div>

    <form class="portfolio-chat__form" data-chat-form>
      <label class="portfolio-chat__label" for="portfolio-chat-question">Your question</label>
      <div class="portfolio-chat__composer">
        <textarea
          id="portfolio-chat-question"
          name="question"
          maxlength="1000"
          rows="2"
          placeholder="Ask a question about Steven…"
          aria-describedby="portfolio-chat-help"
          required
          data-question-input
        ></textarea>
        <button class="portfolio-chat__send" type="submit" data-send-button>
          Send <span aria-hidden="true">↗</span>
        </button>
      </div>
      <p class="portfolio-chat__help" id="portfolio-chat-help">Press Enter to send. Use Shift+Enter for a new line.</p>
      <p class="portfolio-chat__status" data-chat-status role="status" aria-live="polite"></p>
    </form>

    <div class="portfolio-chat__starters" role="group" aria-label="Starter questions">
      <p>Try asking</p>
      <div>
        {starterQuestions.map((question) => (
          <button class="portfolio-chat__starter" type="button" data-starter-question={question}>
            {question}
          </button>
        ))}
      </div>
    </div>

    <section class="portfolio-chat__prepared" aria-labelledby="portfolio-chat-prepared-title">
      <h2 id="portfolio-chat-prepared-title">Prepared FAQs</h2>
      {
        preparedFaqs.map((faq) => (
          <details class="portfolio-chat__faq" data-prepared-faq>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </section>

    <section
      class="portfolio-chat__fallback"
      aria-labelledby="portfolio-chat-fallback-title"
      data-chat-fallback
      hidden
    >
      <h2 id="portfolio-chat-fallback-title">AI answers are temporarily unavailable</h2>
      <p>Review a Prepared FAQ, download Steven's resume, or use one of the contact paths below.</p>
      <a class="button-link button-link--primary" href={resumePdf.path} download>
        Download Resume PDF
      </a>
      <nav class="portfolio-chat__contact-paths" aria-label="Contact paths">
        {
          fallbackContactLinks.map((link) => (
            <a
              href={link.href}
              target={link.isExternal && !link.href.startsWith("mailto:") ? "_blank" : undefined}
              rel={link.isExternal && !link.href.startsWith("mailto:") ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <button class="portfolio-chat__retry" type="button" data-chat-retry>
        Retry failed question
      </button>
    </section>
  </div>
</section>

<script>
  import { createPortfolioChat } from "../scripts/portfolio-chat.js";

  const setupPortfolioChat = () => {
    const root = document.querySelector<HTMLElement>("[data-portfolio-chat]");
    if (!root || root.dataset.ready === "true") return;

    const transcript = root.querySelector<HTMLElement>("[data-transcript]");
    const form = root.querySelector<HTMLFormElement>("[data-chat-form]");
    const input = root.querySelector<HTMLTextAreaElement>("[data-question-input]");
    const sendButton = root.querySelector<HTMLButtonElement>("[data-send-button]");
    const status = root.querySelector<HTMLElement>("[data-chat-status]");
    const fallback = root.querySelector<HTMLElement>("[data-chat-fallback]");
    const retryButton = root.querySelector<HTMLButtonElement>("[data-chat-retry]");
    const preparedFaqs = Array.from(root.querySelectorAll<HTMLDetailsElement>("[data-prepared-faq]"));
    const apiUrl = root.dataset.apiUrl;
    const starterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-starter-question]"));

    if (!transcript || !form || !input || !sendButton || !status || !fallback || !retryButton || !apiUrl) return;
    root.dataset.ready = "true";

    const addMessage = (role: "user" | "assistant", content: string) => {
      const message = document.createElement("p");
      message.className = `portfolio-chat__message portfolio-chat__message--${role}`;
      message.textContent = content;
      transcript.append(message);
      transcript.scrollTop = transcript.scrollHeight;
    };

    const chat = createPortfolioChat({
      apiUrl,
      onStateChange: (state) => {
        if (state.appendQuestion && state.question) addMessage("user", state.question);
        if (state.answer) addMessage("assistant", state.answer);
        if (state.maxQuestionLength) input.maxLength = state.maxQuestionLength;

        const showingFallback = state.status === "unavailable" || state.retrying === true;
        fallback.hidden = !showingFallback;
        if (showingFallback) preparedFaqs.forEach((faq) => { faq.open = true; });
        if (state.status === "ready") preparedFaqs.forEach((faq) => { faq.open = false; });

        const busy = state.status === "pending";
        const unavailable = state.status === "unavailable";
        input.disabled = busy || unavailable;
        sendButton.disabled = busy || unavailable;
        starterButtons.forEach((button) => { button.disabled = busy || unavailable; });
        retryButton.hidden = !showingFallback || state.retryAvailable === false;
        retryButton.disabled = busy;
        status.textContent = state.message ?? "";
      }
    });

    const restoreFocus = () => {
      if (chat.getState().status === "unavailable") retryButton.focus();
      else input.focus();
    };

    const ask = (question: string) => {
      input.value = "";
      void chat.ask(question).then(restoreFocus);
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void ask(input.value);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    starterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const question = button.dataset.starterQuestion;
        if (question) void ask(question);
      });
    });

    retryButton.addEventListener("click", () => {
      void chat.retry().then(restoreFocus);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPortfolioChat, { once: true });
  } else {
    setupPortfolioChat();
  }
</script>

<style>
  .portfolio-chat {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    align-items: start;
    gap: clamp(1.15rem, 3vw, 2.4rem);
    padding-block: clamp(1.1rem, 2.5vw, 2rem) clamp(3rem, 6vw, 4.5rem);
  }

  .portfolio-chat__intro {
    max-width: 34rem;
    padding-block: clamp(0rem, 2vw, 1.25rem);
  }

  .portfolio-chat__eyebrow {
    margin: 0 0 0.45rem;
    color: var(--color-resume);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .portfolio-chat__intro h1 {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: clamp(2.35rem, 5.1vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .portfolio-chat__description {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.5;
  }

  .portfolio-chat__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1.25rem;
  }

  .portfolio-chat__panel {
    display: grid;
    gap: 0.8rem;
    min-width: 0;
    padding: clamp(0.9rem, 2.3vw, 1.35rem);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-soft);
  }

  .portfolio-chat__transcript {
    display: flex;
    min-height: 4.25rem;
    max-height: 16rem;
    flex-direction: column;
    gap: 0.65rem;
    overflow-y: auto;
    padding: 0.1rem;
    scroll-behavior: smooth;
  }

  :global(.portfolio-chat__message) {
    max-width: min(96%, 690px);
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    font-size: 0.96rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  :global(.portfolio-chat__message--assistant) {
    align-self: flex-start;
    border: 1px solid var(--color-border);
    border-end-start-radius: 4px;
    background: var(--color-background);
    color: var(--color-text);
  }

  :global(.portfolio-chat__message--assistant a) {
    color: var(--color-accent-strong);
    font-weight: 750;
    text-underline-offset: 0.15em;
  }

  :global(.portfolio-chat__message--user) {
    align-self: flex-end;
    border-end-end-radius: 4px;
    background: var(--color-accent);
    color: #fff;
  }

  .portfolio-chat__form {
    display: grid;
    gap: 0.35rem;
  }

  .portfolio-chat__label {
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .portfolio-chat__composer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.6rem;
    padding: 0.5rem;
    border: 1px solid #aab7aa;
    border-radius: 12px;
    background: #fff;
  }

  .portfolio-chat__composer:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(31, 59, 46, 0.16);
  }

  .portfolio-chat__composer textarea {
    width: 100%;
    min-height: 3rem;
    max-height: 8rem;
    resize: vertical;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    line-height: 1.45;
    padding: 0.55rem;
  }

  .portfolio-chat__composer textarea::placeholder {
    color: #667168;
  }

  .portfolio-chat__send {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 0;
    border-radius: 8px;
    background: var(--color-resume);
    color: #fff;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.6rem 0.9rem;
    transition: background-color 160ms ease, opacity 160ms ease;
  }

  .portfolio-chat__send:hover {
    background: #873b18;
  }

  .portfolio-chat__send:disabled {
    cursor: progress;
    opacity: 0.68;
  }

  .portfolio-chat__help,
  .portfolio-chat__status {
    min-height: 1rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .portfolio-chat__status:empty {
    min-height: 0;
  }

  .portfolio-chat__starters > p {
    margin: 0 0 0.4rem;
    color: var(--color-muted);
    font-size: 0.81rem;
    font-weight: 750;
  }

  .portfolio-chat__starters > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .portfolio-chat__starter {
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-accent-strong);
    cursor: pointer;
    font-size: 0.81rem;
    font-weight: 700;
    line-height: 1.28;
    padding: 0.45rem 0.7rem;
    text-align: left;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .portfolio-chat__starter:hover:not(:disabled) {
    border-color: var(--color-accent);
    background: #edf1eb;
  }

  .portfolio-chat__starter:disabled {
    cursor: progress;
    opacity: 0.68;
  }

  .portfolio-chat__prepared {
    display: grid;
    gap: 0.55rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.85rem;
  }

  .portfolio-chat__prepared h2,
  .portfolio-chat__fallback h2 {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: 1rem;
  }

  .portfolio-chat__faq {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-cream);
    padding: 0.65rem 0.8rem;
  }

  .portfolio-chat__faq summary {
    color: var(--color-accent-strong);
    cursor: pointer;
    font-weight: 750;
  }

  .portfolio-chat__faq p {
    margin: 0.6rem 0 0;
    line-height: 1.45;
  }

  .portfolio-chat__fallback {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-background);
    padding: 0.9rem;
  }

  .portfolio-chat__fallback[hidden],
  .portfolio-chat__retry[hidden] {
    display: none;
  }

  .portfolio-chat__fallback > p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.45;
  }

  .portfolio-chat__contact-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
  }

  .portfolio-chat__contact-paths a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-underline-offset: 0.15em;
  }

  .portfolio-chat__retry {
    min-height: 2.65rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 8px;
    background: #fff;
    color: var(--color-accent-strong);
    cursor: pointer;
    font: inherit;
    font-weight: 750;
    padding: 0.55rem 0.8rem;
  }

  .portfolio-chat__retry:disabled {
    cursor: progress;
    opacity: 0.68;
  }

  @media (max-width: 850px) {
    .portfolio-chat {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding-block-start: 1rem;
    }

    .portfolio-chat__intro {
      max-width: 46rem;
      padding: 0;
    }

    .portfolio-chat__intro h1 {
      font-size: clamp(2.15rem, 7vw, 3.25rem);
    }

    .portfolio-chat__actions {
      margin-block-start: 0.8rem;
    }

    .portfolio-chat__panel {
      gap: 0.7rem;
    }
  }

  @media (max-width: 520px) {
    .portfolio-chat__panel {
      gap: 0.65rem;
      padding: 0.75rem;
      border-radius: 12px;
    }

    :global(.portfolio-chat__message) {
      max-width: 100%;
      font-size: 0.93rem;
    }

    .portfolio-chat__composer {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .portfolio-chat__send {
      align-self: end;
      padding-inline: 0.75rem;
    }

    .portfolio-chat__starter {
      width: 100%;
      border-radius: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-chat__transcript {
      scroll-behavior: auto;
    }

    .portfolio-chat__send,
    .portfolio-chat__starter {
      transition: none;
    }
  }
</style>
