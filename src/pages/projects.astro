---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildProjectAnalytics, projects } from "../data/projects";

const intro =
  "A small set of personal tools and experiments built to solve real problems, explore product ideas, and deepen technical judgment.";
---

<BaseLayout
  title="Projects"
  description="Selected projects by Steven Byington, including Aeris fitness analytics and SoilOS lawn-care planning."
  canonicalPath="/projects/"
>
  <section class="page-section projects-section">
    <h1>Projects</h1>
    <p>{intro}</p>
    <div class="project-list">
      {
        projects.map((project) => (
          <article class="project-entry">
            <div class="project-entry__content">
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              {
                project.actions.length > 0 && (
                  <nav class="project-links" aria-label={`${project.title} links`}>
                    {project.actions.map((action) => {
                      const analytics = buildProjectAnalytics(project, action, "project_card");

                      return (
                        <a
                          href={action.href}
                          target={action.isExternal ? "_blank" : undefined}
                          rel={action.isExternal ? "noopener noreferrer" : undefined}
                          data-analytics-event={analytics.event}
                          data-analytics-location={analytics.location}
                          data-analytics-target={analytics.target}
                          data-analytics-secondary-event={analytics.secondaryEvent}
                          data-analytics-secondary-target={analytics.secondaryTarget}
                        >
                          {action.label}
                        </a>
                      );
                    })}
                  </nav>
                )
              }
            </div>
            <figure class="project-entry__media">
              <img
                src={project.previewScreenshot.path}
                alt={project.previewScreenshot.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
