---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resumePdf } from "../data/launchAssets";
---

<BaseLayout
  title="Resume"
  description="Resume details and PDF link for Steven Byington."
>
  <section class="page-section">
    <h1>Resume</h1>
    <p>
      Resume content will build from this route, with the PDF path reserved at
      <a href={resumePdf.path}>{resumePdf.path}</a>.
    </p>
  </section>
</BaseLayout>
