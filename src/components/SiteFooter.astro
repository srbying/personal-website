---
import { footerLinks, siteMetadata } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__identity">
      &copy; {year} {siteMetadata.name}
    </p>

    <nav class="site-footer__links" aria-label="Footer links">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            target={link.isExternal && !link.href.startsWith("mailto:") ? "_blank" : undefined}
            rel={link.isExternal && !link.href.startsWith("mailto:") ? "noopener noreferrer" : undefined}
            download={!link.isExternal && link.href.endsWith(".pdf") ? true : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
