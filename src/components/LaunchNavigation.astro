---
import { brandAssets } from "../data/launchAssets";
import { launchNavigation, siteMetadata } from "../data/site";

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

function isActiveNavigationItem(href: string): boolean {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

<header class="site-header" data-launch-navigation data-menu-state="closed">
  <a class="brand-link" href="/" aria-label={`${siteMetadata.name} home`}>
    <img
      class="brand-wordmark"
      src={brandAssets.desktopHeader.path}
      alt=""
      width={brandAssets.desktopHeader.width}
      height={brandAssets.desktopHeader.height}
      decoding="async"
    />
    <img
      class="brand-icon"
      src={brandAssets.compactIcon.path}
      alt=""
      width={brandAssets.compactIcon.width}
      height={brandAssets.compactIcon.height}
      decoding="async"
    />
  </a>

  <nav class="desktop-navigation" aria-label="Launch navigation">
    {
      launchNavigation.map((item) => (
        <a
          class:list={[
            "navigation-link",
            { "navigation-link--active": isActiveNavigationItem(item.href) }
          ]}
          href={item.href}
          aria-current={isActiveNavigationItem(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <button
    class="mobile-navigation-toggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    data-nav-toggle
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="Mobile launch navigation"
    aria-hidden="true"
    data-open="false"
    hidden
  >
    {
      launchNavigation.map((item) => (
        <a
          class:list={[
            "mobile-navigation-link",
            { "mobile-navigation-link--active": isActiveNavigationItem(item.href) }
          ]}
          href={item.href}
          aria-current={isActiveNavigationItem(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const setupLaunchNavigation = () => {
    const header = document.querySelector("[data-launch-navigation]");

    if (!(header instanceof HTMLElement) || header.dataset.navigationReady === "true") {
      return;
    }

    header.dataset.navigationReady = "true";

    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const headerScrollDistance = 96;
    const headerFallbackProperties = [
      "--header-height",
      "--header-padding-block",
      "--brand-link-height",
      "--brand-wordmark-width",
      "--brand-icon-size"
    ];
    let headerAnimationFrame = 0;

    const supportsNativeHeaderAnimation = () =>
      !reducedMotionQuery.matches &&
      typeof CSS !== "undefined" &&
      CSS.supports("(animation-timeline: scroll()) and (animation-range: 0% 100%)");

    const getHeaderScrollProgress = () => {
      const scrollProgress = Math.min(1, Math.max(0, window.scrollY / headerScrollDistance));

      return reducedMotionQuery.matches ? Number(scrollProgress >= 1) : scrollProgress;
    };

    const getHeaderFallbackValues = () => {
      const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const isMobile = window.matchMedia("(max-width: 840px)").matches;
      const isSmallMobile = window.matchMedia("(max-width: 520px)").matches;

      return {
        "--header-height": [isMobile ? 68 : 76, isMobile ? 56 : 58],
        "--header-padding-block": isMobile
          ? [0.75 * rootFontSize, 0.375 * rootFontSize]
          : [0.1 * rootFontSize, 0.165 * rootFontSize],
        "--brand-link-height": isMobile
          ? [2.75 * rootFontSize, 2.75 * rootFontSize]
          : [4.55 * rootFontSize, 3.3 * rootFontSize],
        "--brand-wordmark-width": [20 * rootFontSize, 14.5 * rootFontSize],
        "--brand-icon-size": [
          (isSmallMobile ? 2.35 : 2.55) * rootFontSize,
          2.05 * rootFontSize
        ]
      };
    };

    const setHeaderFallbackValue = (property, [expandedValue, compactValue], progress) => {
      const value = expandedValue + (compactValue - expandedValue) * progress;

      header.style.setProperty(property, `${value.toFixed(2)}px`);
    };

    const syncHeaderScrollProgress = () => {
      headerAnimationFrame = 0;

      if (supportsNativeHeaderAnimation()) {
        headerFallbackProperties.forEach((property) => {
          header.style.removeProperty(property);
        });
        return;
      }

      const progress = getHeaderScrollProgress();
      const fallbackValues = getHeaderFallbackValues();

      headerFallbackProperties.forEach((property) => {
        setHeaderFallbackValue(property, fallbackValues[property], progress);
      });
    };

    const requestHeaderScrollProgressSync = () => {
      if (headerAnimationFrame !== 0) {
        return;
      }

      headerAnimationFrame = window.requestAnimationFrame(syncHeaderScrollProgress);
    };

    syncHeaderScrollProgress();
    window.addEventListener("scroll", requestHeaderScrollProgressSync, { passive: true });
    window.addEventListener("resize", requestHeaderScrollProgressSync);
    reducedMotionQuery.addEventListener("change", requestHeaderScrollProgressSync);

    const toggle = header.querySelector("[data-nav-toggle]");
    const panel = header.querySelector("#mobile-navigation");

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
      return;
    }

    const desktopQuery = window.matchMedia("(min-width: 841px)");
    const panelLinks = Array.from(panel.querySelectorAll("a"));

    const setOpen = (isOpen) => {
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      panel.setAttribute("aria-hidden", String(!isOpen));
      panel.toggleAttribute("inert", !isOpen);
      panel.inert = !isOpen;
      header.dataset.menuState = isOpen ? "open" : "closed";

      if (isOpen) {
        panel.hidden = false;

        if (reducedMotionQuery.matches) {
          panel.dataset.open = "true";
          return;
        }

        requestAnimationFrame(() => {
          panel.dataset.open = "true";
        });
        return;
      }

      panel.dataset.open = "false";

      if (reducedMotionQuery.matches) {
        panel.hidden = true;
        return;
      }

      const hidePanel = () => {
        if (panel.dataset.open !== "true") {
          panel.hidden = true;
        }
        panel.removeEventListener("transitionend", hidePanel);
      };

      panel.addEventListener("transitionend", hidePanel);
      window.setTimeout(hidePanel, 260);
    };

    const closeMenu = ({ shouldFocusToggle = false } = {}) => {
      if (toggle.getAttribute("aria-expanded") !== "true") {
        return;
      }

      setOpen(false);

      if (shouldFocusToggle) {
        toggle.focus({ preventScroll: true });
      }
    };

    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    panelLinks.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu({ shouldFocusToggle: true });
      }
    });

    const handleDesktopQueryChange = (event) => {
      if (event.matches) {
        setOpen(false);
      }
    };

    handleDesktopQueryChange(desktopQuery);
    desktopQuery.addEventListener("change", handleDesktopQueryChange);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLaunchNavigation, { once: true });
  } else {
    setupLaunchNavigation();
  }

  document.addEventListener("astro:page-load", setupLaunchNavigation);
</script>
