---
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioChat from "../components/PortfolioChat.astro";
import { resumePdf } from "../data/launchAssets";
import {
  closingCtas,
  homeHero,
  leadershipPrinciples,
  recentExperience,
  type HomeCta
} from "../data/home";
import { structuredIdentityMetadata } from "../data/site";

function getHomeCtaAnalytics(cta: HomeCta, location: "home_hero" | "home_close") {
  if (cta.href === resumePdf.path) {
    return { event: "resume_download", location, target: "resume_pdf" };
  }

  if (cta.href === "/experience/") {
    return { event: "impact_click", location, target: "selected_impact" };
  }

  if (cta.href === "/contact/") {
    return { event: "contact_click", location, target: "email" };
  }

  return undefined;
}

const heroCtas = [...homeHero.ctas].sort((left, right) => {
  if (left.href === "/experience/") return -1;
  if (right.href === "/experience/") return 1;
  return 0;
});
---

<BaseLayout
  title="Steven Byington | Software Engineering Manager"
  description="Software Engineering Manager with full-stack depth, product-minded leadership, and a USMC leadership foundation."
  canonicalPath="/"
  structuredData={structuredIdentityMetadata}
>
  <section class="fieldbook-hero" aria-labelledby="home-title">
    <ol class="fieldbook-ruler" aria-hidden="true">
      {Array.from({ length: 11 }, (_, index) => (
        <li><span>{String(index).padStart(2, "0")}</span></li>
      ))}
    </ol>

    <p class="fieldbook-meta">{homeHero.metadata}</p>

    <h1 class="fieldbook-title" id="home-title">
      {homeHero.headline.split(" ").map((word) => <span>{word}</span>)}
    </h1>

    <p class="fieldbook-intro">{homeHero.supportingLine}</p>

    <div class="fieldbook-actions" aria-label="Portfolio actions">
      {
        heroCtas.map((cta, index) => (
          <a
            class:list={[
              "fieldbook-action",
              index === 0 && "fieldbook-action--primary"
            ]}
            href={cta.href}
            download={cta.href === resumePdf.path ? true : undefined}
            data-analytics-event={getHomeCtaAnalytics(cta, "home_hero")?.event}
            data-analytics-location={getHomeCtaAnalytics(cta, "home_hero")?.location}
            data-analytics-target={getHomeCtaAnalytics(cta, "home_hero")?.target}
          >
            <span>{cta.label}</span>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 18">
              <path d="M1 9h20m-7-7 7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </div>

    <figure class="fieldbook-evidence" aria-labelledby="aeris-evidence-label">
      <img
        class="fieldbook-evidence__plate"
        src="/assets/plates/aeris-screenshot.png"
        alt="Aeris chat response comparing running pace at similar heart rates."
        width="1440"
        height="1130"
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="fieldbook-evidence__mobile-shot"
        src="/assets/projects/aeris/chat-response.png"
        alt="Aeris chat response comparing running pace at similar heart rates."
        width="2424"
        height="1502"
        loading="lazy"
        decoding="async"
      />
      <div class="fieldbook-evidence__frame" aria-hidden="true"></div>
      <figcaption class="fieldbook-evidence__labels">
        <span class="fieldbook-evidence__label fieldbook-evidence__label--aeris" id="aeris-evidence-label">
          AERIS / FITNESS ANALYTICS
        </span>
        <span class="fieldbook-evidence__label fieldbook-evidence__label--pace">
          PACE AT SIMILAR HEART RATES
        </span>
      </figcaption>
    </figure>

    <div class="fieldbook-baseline" aria-hidden="true">
      <span class="fieldbook-baseline__line"></span>
      <span class="fieldbook-baseline__mark fieldbook-baseline__mark--left"></span>
      <span class="fieldbook-baseline__mark fieldbook-baseline__mark--right"></span>
      <span class="fieldbook-baseline__ratio">16:10</span>
    </div>
  </section>

  <div class="fieldbook-content">
    <section class="home-section recent-experience" aria-labelledby="recent-experience-heading">
      <div class="section-heading">
        <h2 id="recent-experience-heading">Teams, systems, and product work</h2>
      </div>
      <div class="recent-experience__rows">
        {
          recentExperience.map((item) => (
            <article class="recent-experience__row">
              <div>
                <h3>{item.company}</h3>
                <p>{item.role}</p>
              </div>
              <time>{item.dateRange}</time>
            </article>
          ))
        }
      </div>
    </section>

    <PortfolioChat />

    <section class="home-section leadership-section" aria-labelledby="leadership-heading">
      <div class="section-heading">
        <h2 id="leadership-heading">A practical operating style</h2>
      </div>
      <ol class="leadership-list">
        {
          leadershipPrinciples.map((principle) => (
            <li>
              <h3>{principle.title}</h3>
              <p>{principle.sentence}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-close" aria-labelledby="home-close-heading">
      <div>
        <h2 id="home-close-heading">Want the concise version?</h2>
      </div>
      <div class="hero-actions home-close__actions" aria-label="Resume and contact links">
        {
          closingCtas.map((cta) => (
            <a
              class:list={[
                "button-link",
                cta.variant === "primary" && "button-link--primary"
              ]}
              href={cta.href}
              download={cta.href === resumePdf.path ? true : undefined}
              data-analytics-event={getHomeCtaAnalytics(cta, "home_close")?.event}
              data-analytics-location={getHomeCtaAnalytics(cta, "home_close")?.location}
              data-analytics-target={getHomeCtaAnalytics(cta, "home_close")?.target}
            >
              <span>{cta.label}</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 18">
                <path d="M1 9h20m-7-7 7 7-7 7" />
              </svg>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
