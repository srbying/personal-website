---
import BaseLayout from "../layouts/BaseLayout.astro";
import { heroLandscape, resumePdf } from "../data/launchAssets";
---

<BaseLayout title="Home">
  <section class="hero-section">
    <picture class="hero-section__media">
      <source srcset={heroLandscape.path} type="image/webp" />
      <img
        src={heroLandscape.fallbackPath}
        alt={heroLandscape.alt}
        width={heroLandscape.width}
        height={heroLandscape.height}
        loading="eager"
        decoding="async"
      />
    </picture>
    <div class="hero-section__content">
      <p class="hero-kicker">Engineering Manager</p>
      <h1>Steven Byington</h1>
      <p>
        Engineering Manager with 10+ years of full-stack experience. I help
        product-minded teams build with clarity, ownership, and technical
        judgment.
      </p>
      <p class="hero-proof">Engineering Manager &middot; Full-Stack Depth &middot; USMC Veteran</p>
      <div class="hero-actions" aria-label="Primary links">
        <a class="button-link button-link--primary" href={resumePdf.path}>
          Download My Resume
        </a>
        <a class="button-link" href="/experience/">See My Experience</a>
      </div>
    </div>
  </section>

  <section class="overview-grid" aria-label="Portfolio sections">
    <a class="overview-card" href="/experience/">
      <span>Experience</span>
      <strong>Professional background and roles.</strong>
    </a>
    <a class="overview-card" href="/projects/">
      <span>Projects</span>
      <strong>Selected work and build notes.</strong>
    </a>
    <a class="overview-card" href="/resume/">
      <span>Resume</span>
      <strong>Readable page now, PDF path ready.</strong>
    </a>
  </section>
</BaseLayout>
