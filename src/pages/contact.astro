---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactLinks } from "../data/launchAssets";

const orderedContactLinks = [
  contactLinks.email,
  contactLinks.linkedIn,
  contactLinks.github,
  contactLinks.resumePdf
];

function getContactAnalytics(link: { href?: string }) {
  if (!link.href) {
    return undefined;
  }

  if (link.href.startsWith("mailto:")) {
    return { event: "email_click", target: "email" };
  }

  if (link.href.includes("linkedin.com")) {
    return { event: "linkedin_click", target: "linkedin" };
  }

  if (link.href.includes("github.com")) {
    return { event: "github_click", target: "github" };
  }

  if (link.href.endsWith(".pdf")) {
    return { event: "resume_download", target: "resume_pdf" };
  }

  return undefined;
}
---

<BaseLayout
  title="Contact"
  description="Public contact links for Steven Byington, including email, LinkedIn, GitHub, and resume."
  canonicalPath="/contact/"
>
  <section class="page-section contact-section">
    <h1>Contact</h1>
    <p>
      The best way to reach me is by email. You can also find me on LinkedIn.
    </p>
    <dl class="contact-list">
      {
        orderedContactLinks.map((link) => (
          <div class="contact-list__item">
            <dt>{link.label}</dt>
            <dd>
              <a
                href={link.href}
                target={link.isExternal && !link.href.startsWith("mailto:") ? "_blank" : undefined}
                rel={link.isExternal && !link.href.startsWith("mailto:") ? "noopener noreferrer" : undefined}
                download={!link.isExternal && link.href.endsWith(".pdf") ? true : undefined}
                data-analytics-event={getContactAnalytics(link)?.event}
                data-analytics-location="contact_page"
                data-analytics-target={getContactAnalytics(link)?.target}
              >
                {link.displayText}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
