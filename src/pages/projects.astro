---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, type ProjectAction, type ProjectSummary } from "../data/projects";

const intro =
  "A small set of personal tools and experiments built to solve real problems, explore product ideas, and deepen technical judgment.";

function getProjectActionAnalytics(project: ProjectSummary, action: ProjectAction) {
  const target = project.id === "aeris" ? "aeris" : "soilos";

  return {
    event: "project_click",
    location: "project_card",
    target,
    secondaryEvent: action.href.includes("github.com") ? "github_click" : undefined,
    secondaryTarget: action.href.includes("github.com") ? "github" : undefined
  };
}
---

<BaseLayout
  title="Projects"
  description="Selected projects by Steven Byington, including Aeris fitness analytics and SoilOS lawn-care planning."
  canonicalPath="/projects/"
>
  <section class="page-section projects-section">
    <h1>Projects</h1>
    <p>{intro}</p>
    <div class="project-list">
      {
        projects.map((project) => (
          <article class="project-entry">
            <div class="project-entry__content">
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              {
                project.actions.length > 0 && (
                  <nav class="project-links" aria-label={`${project.title} links`}>
                    {project.actions.map((action) => (
                      <a
                        href={action.href}
                        target={action.isExternal ? "_blank" : undefined}
                        rel={action.isExternal ? "noopener noreferrer" : undefined}
                        data-analytics-event={getProjectActionAnalytics(project, action).event}
                        data-analytics-location={getProjectActionAnalytics(project, action).location}
                        data-analytics-target={getProjectActionAnalytics(project, action).target}
                        data-analytics-secondary-event={getProjectActionAnalytics(project, action).secondaryEvent}
                        data-analytics-secondary-target={getProjectActionAnalytics(project, action).secondaryTarget}
                      >
                        {action.label}
                      </a>
                    ))}
                  </nav>
                )
              }
            </div>
            <figure class="project-entry__media">
              <img
                src={project.previewScreenshot.path}
                alt={project.previewScreenshot.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
