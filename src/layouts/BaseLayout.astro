---
import SpeedInsights from '@vercel/speed-insights/astro';
import LaunchNavigation from "../components/LaunchNavigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteMetadata } from "../data/site";
import { analyticsClientScript } from "../scripts/analytics";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: unknown;
  robots?: string;
  analyticsPageEvent?: string;
  analyticsPageLocation?: string;
  analyticsPageTarget?: string;
};

const {
  title = siteMetadata.name,
  description = siteMetadata.description,
  canonicalPath = Astro.url.pathname,
  structuredData,
  robots,
  analyticsPageEvent,
  analyticsPageLocation,
  analyticsPageTarget
} = Astro.props;

const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const clarityProjectId = import.meta.env.PUBLIC_MICROSOFT_CLARITY_PROJECT_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const shouldRenderGa4 = import.meta.env.PROD && Boolean(ga4MeasurementId);
const shouldRenderClarity = import.meta.env.PROD && Boolean(clarityProjectId);
const ga4ScriptUrl = ga4MeasurementId
  ? `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4MeasurementId)}`
  : undefined;
const ga4MeasurementIdJson = ga4MeasurementId
  ? JSON.stringify(ga4MeasurementId).replaceAll("<", "\\u003c")
  : undefined;
const clarityProjectIdJson = clarityProjectId
  ? JSON.stringify(clarityProjectId).replaceAll("<", "\\u003c")
  : undefined;
const ga4InitScript = ga4MeasurementIdJson
  ? `
window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
window.gtag = window.gtag || gtag;
gtag("js", new Date());
gtag("config", ${ga4MeasurementIdJson});
`
  : undefined;
const clarityScript = clarityProjectIdJson
  ? `
(function(c,l,a,r,i,t,y){
  c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments);};
  t=l.createElement(r);
  t.async=1;
  t.src="https://www.clarity.ms/tag/"+i;
  y=l.getElementsByTagName(r)[0];
  y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", ${clarityProjectIdJson});
`
  : undefined;
const pageTitle =
  title.includes(siteMetadata.name)
    ? title
    : siteMetadata.titleTemplate.replace("%s", title);
const canonicalUrl = siteMetadata.toAbsoluteUrl(canonicalPath);
const openGraphImageUrl = siteMetadata.toAbsoluteUrl(siteMetadata.defaultOpenGraphImage);
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.author} />
    {robots && <meta name="robots" content={robots} />}
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:site_name" content={siteMetadata.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:alt" content={siteMetadata.defaultOpenGraphImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    {shouldRenderGa4 && ga4ScriptUrl && <script async src={ga4ScriptUrl} is:inline />}
    {shouldRenderGa4 && ga4InitScript && <script is:inline set:html={ga4InitScript} />}
    {shouldRenderClarity && clarityScript && <script is:inline set:html={clarityScript} />}
    {
      structuredDataJson && (
        <script type="application/ld+json" set:html={structuredDataJson} />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body
    data-analytics-page-event={analyticsPageEvent}
    data-analytics-page-location={analyticsPageLocation}
    data-analytics-page-target={analyticsPageTarget}
  >
    <a class="skip-link" href="#main-content" data-skip-link>Skip to content</a>
    <div class="site-shell">
      <LaunchNavigation />
      <main id="main-content" class="site-main" tabindex="-1" data-main-content>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      const setupSkipLink = () => {
        const skipLink = document.querySelector("[data-skip-link]");
        const mainContent = document.querySelector("[data-main-content]");

        if (
          !(skipLink instanceof HTMLAnchorElement) ||
          !(mainContent instanceof HTMLElement) ||
          skipLink.dataset.skipReady === "true"
        ) {
          return;
        }

        skipLink.dataset.skipReady = "true";

        const activateSkipLink = () => {
          mainContent.focus({ preventScroll: true });
          mainContent.scrollIntoView({ block: "start" });

          if (window.location.hash !== "#main-content") {
            history.pushState(null, "", "#main-content");
          }
        };

        skipLink.addEventListener("click", (event) => {
          event.preventDefault();
          activateSkipLink();
        });

        skipLink.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            activateSkipLink();
          }
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupSkipLink, { once: true });
      } else {
        setupSkipLink();
      }

      document.addEventListener("astro:page-load", setupSkipLink);
    </script>
    {shouldRenderGa4 && <script is:inline set:html={analyticsClientScript} />}
    <SpeedInsights />
  </body>
</html>
