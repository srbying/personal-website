---
import { launchNavigation, siteMetadata } from "../data/site";

const visibleNavigation = launchNavigation.filter((item) => item.href !== "/");

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

function isActiveNavigationItem(href: string): boolean {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}

function getNavigationAnalytics(item: { href: string }) {
  if (item.href === "/experience/") {
    return {
      event: "impact_click",
      location: "nav",
      target: "selected_impact"
    };
  }

  if (item.href === "/contact/") {
    return {
      event: "contact_click",
      location: "nav",
      target: "email"
    };
  }

  return undefined;
}
---

<header class="site-header" data-launch-navigation data-menu-state="closed">
  <a class="brand-link" href="/" aria-label={`${siteMetadata.name} home`}>
    {siteMetadata.name}
  </a>

  <div class="site-header__measurements" aria-hidden="true">
    <span class="site-header__tick site-header__tick--one"></span>
    <span class="site-header__tick site-header__tick--two"></span>
    <span class="site-header__tick site-header__tick--three"></span>
    <span class="site-header__registration"></span>
  </div>

  <nav class="desktop-navigation" aria-label="Launch navigation">
    {
      visibleNavigation.map((item) => {
        const analytics = getNavigationAnalytics(item);

        return (
          <a
            class:list={[
              "navigation-link",
              { "navigation-link--active": isActiveNavigationItem(item.href) }
            ]}
            href={item.href}
            aria-current={isActiveNavigationItem(item.href) ? "page" : undefined}
            data-analytics-event={analytics?.event}
            data-analytics-location={analytics?.location}
            data-analytics-target={analytics?.target}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <button
    class="mobile-navigation-toggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    data-nav-toggle
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="Mobile launch navigation"
    aria-hidden="true"
    data-open="false"
    hidden
  >
    {
      visibleNavigation.map((item) => {
        const analytics = getNavigationAnalytics(item);

        return (
          <a
            class:list={[
              "mobile-navigation-link",
              { "mobile-navigation-link--active": isActiveNavigationItem(item.href) }
            ]}
            href={item.href}
            aria-current={isActiveNavigationItem(item.href) ? "page" : undefined}
            data-analytics-event={analytics?.event}
            data-analytics-location={analytics?.location}
            data-analytics-target={analytics?.target}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<script>
  const setupLaunchNavigation = () => {
    const header = document.querySelector("[data-launch-navigation]");

    if (!(header instanceof HTMLElement) || header.dataset.navigationReady === "true") {
      return;
    }

    header.dataset.navigationReady = "true";

    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

    const toggle = header.querySelector("[data-nav-toggle]");
    const panel = header.querySelector("#mobile-navigation");

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
      return;
    }

    const desktopQuery = window.matchMedia("(min-width: 901px)");
    const panelLinks = Array.from(panel.querySelectorAll("a"));

    const setOpen = (isOpen) => {
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      panel.setAttribute("aria-hidden", String(!isOpen));
      panel.toggleAttribute("inert", !isOpen);
      panel.inert = !isOpen;
      header.dataset.menuState = isOpen ? "open" : "closed";

      if (isOpen) {
        panel.hidden = false;

        if (reducedMotionQuery.matches) {
          panel.dataset.open = "true";
          return;
        }

        requestAnimationFrame(() => {
          panel.dataset.open = "true";
        });
        return;
      }

      panel.dataset.open = "false";

      if (reducedMotionQuery.matches) {
        panel.hidden = true;
        return;
      }

      const hidePanel = () => {
        if (panel.dataset.open !== "true") {
          panel.hidden = true;
        }
        panel.removeEventListener("transitionend", hidePanel);
      };

      panel.addEventListener("transitionend", hidePanel);
      window.setTimeout(hidePanel, 260);
    };

    const closeMenu = ({ shouldFocusToggle = false } = {}) => {
      if (toggle.getAttribute("aria-expanded") !== "true") {
        return;
      }

      setOpen(false);

      if (shouldFocusToggle) {
        toggle.focus({ preventScroll: true });
      }
    };

    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    panelLinks.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu({ shouldFocusToggle: true });
      }
    });

    const handleDesktopQueryChange = (event) => {
      if (event.matches) {
        setOpen(false);
      }
    };

    handleDesktopQueryChange(desktopQuery);
    desktopQuery.addEventListener("change", handleDesktopQueryChange);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLaunchNavigation, { once: true });
  } else {
    setupLaunchNavigation();
  }

  document.addEventListener("astro:page-load", setupLaunchNavigation);
</script>
