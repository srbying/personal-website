---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <section class="hero-section">
    <div class="hero-section__content">
      <h1>Steven Byington</h1>
      <p>
        A focused portfolio for experience, selected projects, resume details,
        and clear ways to get in touch.
      </p>
      <div class="hero-actions" aria-label="Primary links">
        <a class="button-link button-link--primary" href="/resume/">Resume</a>
        <a class="button-link" href="/contact/">Contact</a>
      </div>
    </div>
  </section>

  <section class="overview-grid" aria-label="Portfolio sections">
    <a class="overview-card" href="/experience/">
      <span>Experience</span>
      <strong>Professional background and roles.</strong>
    </a>
    <a class="overview-card" href="/projects/">
      <span>Projects</span>
      <strong>Selected work and build notes.</strong>
    </a>
    <a class="overview-card" href="/resume/">
      <span>Resume</span>
      <strong>Readable page now, PDF path ready.</strong>
    </a>
  </section>
</BaseLayout>
