{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev --config workers/steven-assistant/wrangler.jsonc --ip 127.0.0.1",
    "deploy:worker": "wrangler deploy --config workers/steven-assistant/wrangler.jsonc",
    "knowledge:demo": "node --env-file=workers/steven-assistant/.dev.vars workers/steven-assistant/knowledge-demo.mjs",
    "test:knowledge": "node --env-file=workers/steven-assistant/.dev.vars --test workers/steven-assistant/knowledge-demo.test.mjs",
    "test:worker": "node --test workers/steven-assistant/src/worker.test.js",
    "build": "astro build",
    "preview": "astro preview",
    "test:acceptance": "node scripts/validate-shell.mjs",
    "test:assets": "node scripts/validate-assets.mjs",
    "test:home": "node scripts/validate-home.mjs",
    "test:resume": "node scripts/validate-resume.mjs",
    "test:experience": "node scripts/validate-experience.mjs",
    "test:contact": "node scripts/validate-contact.mjs",
    "test:projects": "node scripts/validate-projects.mjs",
    "test:seo": "node scripts/validate-seo.mjs",
    "test:analytics": "node scripts/validate-analytics.mjs",
    "test:accessibility": "node scripts/validate-accessibility-qa.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "4.143.0"
  }
}
